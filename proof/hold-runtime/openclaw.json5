// Isolated proof gateway for PR 152428 (consult transcript hold). Loopback only, plain ws,
// own state dir, debug logging so the hold begin/release lines land in the file log.
{
  gateway: {
    mode: "local",
    port: 18998,
    bind: "loopback",
    tls: { enabled: false },
    auth: { mode: "token", token: "<redacted>" },
  },
  logging: {
    level: "debug",
    consoleLevel: "debug",
  },
  agents: {
    defaults: {
      model: { primary: "google/gemini-3.7-flash" },
    },
  },
  talk: {
    realtime: {
      provider: "google",
      mode: "realtime",
      transport: "gateway-relay",
      // Run 2: make the model speak a short filler before calling the consult tool so the
      // hold has a final to keep (the Gemini 3.8 "checking" behaviour from #150204).
      instructions: "Whenever you call the openclaw_agent_consult tool, first say out loud a short sentence such as 'One moment, let me check that.' and only then call the tool.",
      // Run 6: default model (gemini-3.1-flash-live-preview) with forced consult routing, so
      // the model speaks its own "checking" response while the consult run is admitted.
      consultRouting: "force-agent-consult",
    },
  },
}
